{
 "info": {"name": "Fahrimart API", "description": "Koleksi pengujian API Fahrimart. Jalankan folder dari atas ke bawah (Runner).", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
 "event": [{"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"]}}],
 "variable": [{"key": "base_url", "value": "http://127.0.0.1:8000"}, {"key": "pemilik_email", "value": "pemilik@fahrimart.test"}, {"key": "pemilik_password", "value": ""}, {"key": "admin_email", "value": "admin@fahrimart.test"}, {"key": "admin_password", "value": ""}, {"key": "kasir_email", "value": "kasir@fahrimart.test"}, {"key": "kasir_password", "value": ""}, {"key": "token_pemilik", "value": ""}, {"key": "token_admin", "value": ""}, {"key": "token_kasir", "value": ""}, {"key": "barang_id", "value": ""}],
 "item": [
  {"name": "1. Auth", "item": [
   {"name": "Login Pemilik", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/login", "auth": {"type": "noauth"}, "body": {"mode": "raw", "raw": "{\"email\": \"{{pemilik_email}}\", \"password\": \"{{pemilik_password}}\"}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Status 200\", () => pm.response.to.have.status(200));", "const json = pm.response.json();", "pm.test(\"Token diterima\", () => pm.expect(json.data.token).to.be.a(\"string\"));", "pm.collectionVariables.set(\"token_pemilik\", json.data.token);"]}}]},
   {"name": "Login Admin", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/login", "auth": {"type": "noauth"}, "body": {"mode": "raw", "raw": "{\"email\": \"{{admin_email}}\", \"password\": \"{{admin_password}}\"}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Status 200\", () => pm.response.to.have.status(200));", "const json = pm.response.json();", "pm.test(\"Token diterima\", () => pm.expect(json.data.token).to.be.a(\"string\"));", "pm.collectionVariables.set(\"token_admin\", json.data.token);"]}}]},
   {"name": "Login Kasir", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/login", "auth": {"type": "noauth"}, "body": {"mode": "raw", "raw": "{\"email\": \"{{kasir_email}}\", \"password\": \"{{kasir_password}}\"}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Status 200\", () => pm.response.to.have.status(200));", "const json = pm.response.json();", "pm.test(\"Token diterima\", () => pm.expect(json.data.token).to.be.a(\"string\"));", "pm.collectionVariables.set(\"token_kasir\", json.data.token);"]}}]},
   {"name": "Login - password salah (401)", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/login", "auth": {"type": "noauth"}, "body": {"mode": "raw", "raw": "{\"email\": \"{{pemilik_email}}\", \"password\": \"salah-total\"}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Status 401\", () => pm.response.to.have.status(401));"]}}]},
   {"name": "Me - Pemilik", "request": {"method": "GET", "header": [], "url": "{{base_url}}/api/me", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_pemilik}}", "type": "string"}]}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Status 200\", () => pm.response.to.have.status(200));", "pm.test(\"Role pemilik\", () => pm.expect(pm.response.json().data.role).to.eql(\"pemilik\"));"]}}]},
   {"name": "Me tanpa token (401)", "request": {"method": "GET", "header": [], "url": "{{base_url}}/api/me", "auth": {"type": "noauth"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Status 401\", () => pm.response.to.have.status(401));"]}}]}
  ]},
  {"name": "2. Barang (Pemilik dan Admin)", "item": [
   {"name": "Daftar barang (Admin)", "request": {"method": "GET", "header": [], "url": "{{base_url}}/api/barang?per_page=5", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_admin}}", "type": "string"}]}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Status 200\", () => pm.response.to.have.status(200));", "pm.test(\"Data berupa array\", () => pm.expect(pm.response.json().data).to.be.an(\"array\"));"]}}]},
   {"name": "Cari barang", "request": {"method": "GET", "header": [], "url": "{{base_url}}/api/barang?q=beras", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_admin}}", "type": "string"}]}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Status 200\", () => pm.response.to.have.status(200));"]}}]},
   {"name": "Tambah barang (Pemilik)", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/barang", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_pemilik}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"nama_barang\": \"Gula Pasir\", \"kategori\": \"Sembako\", \"satuan\": \"Kg\", \"harga_beli\": 14000, \"harga_jual\": 16000, \"stok\": 20}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Status 201\", () => pm.response.to.have.status(201));", "pm.collectionVariables.set(\"barang_id\", pm.response.json().data.id_barang);"]}}]},
   {"name": "Detail barang", "request": {"method": "GET", "header": [], "url": "{{base_url}}/api/barang/{{barang_id}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_admin}}", "type": "string"}]}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Status 200\", () => pm.response.to.have.status(200));", "pm.test(\"Nama sesuai\", () => pm.expect(pm.response.json().data.nama_barang).to.eql(\"Gula Pasir\"));"]}}]},
   {"name": "Ubah barang", "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/barang/{{barang_id}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_pemilik}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"nama_barang\": \"Gula Pasir Premium\", \"kategori\": \"Sembako\", \"satuan\": \"Kg\", \"harga_beli\": 14500, \"harga_jual\": 17000}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Status 200\", () => pm.response.to.have.status(200));", "pm.test(\"Harga jual berubah\", () => pm.expect(pm.response.json().data.harga_jual).to.eql(17000));"]}}]},
   {"name": "Tambah barang - data tidak valid (422)", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/barang", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_pemilik}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"nama_barang\": \"\", \"harga_jual\": -5}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Status 422\", () => pm.response.to.have.status(422));"]}}]},
   {"name": "Tambah barang oleh Kasir (403)", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/barang", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_kasir}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"nama_barang\": \"Gula Pasir\", \"kategori\": \"Sembako\", \"satuan\": \"Kg\", \"harga_beli\": 14000, \"harga_jual\": 16000, \"stok\": 20}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Status 403\", () => pm.response.to.have.status(403));"]}}]},
   {"name": "Hapus barang", "request": {"method": "DELETE", "header": [], "url": "{{base_url}}/api/barang/{{barang_id}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_pemilik}}", "type": "string"}]}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Status 200\", () => pm.response.to.have.status(200));"]}}]},
   {"name": "Detail barang yang sudah dihapus (404)", "request": {"method": "GET", "header": [], "url": "{{base_url}}/api/barang/{{barang_id}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_admin}}", "type": "string"}]}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Status 404\", () => pm.response.to.have.status(404));"]}}]}
  ]},
  {"name": "3. Logout", "item": [
   {"name": "Logout Pemilik", "request": {"method": "POST", "header": [], "url": "{{base_url}}/api/logout", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_pemilik}}", "type": "string"}]}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Status 200\", () => pm.response.to.have.status(200));"]}}]},
   {"name": "Me setelah logout (401)", "request": {"method": "GET", "header": [], "url": "{{base_url}}/api/me", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_pemilik}}", "type": "string"}]}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Status 401\", () => pm.response.to.have.status(401));"]}}]}
  ]}
 ]
}